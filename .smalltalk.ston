SmalltalkCISpec {
  #preLoading : SCICustomScript {
    #path : 'scripts/preLoadingPharo.st',
    #platforms : [ #pharo ]
  },
  #loading : [
    SCIMetacelloLoadSpec {
      #baseline : 'MCP',
      #directory : 'src',
	  #load : [ 'all' ],
      #ignoreImage : true,
      #onConflict : #useIncoming,
      #onUpgrade : #useIncoming
    }
  ],
  #testing : {
    #packages : [
      'MCP-Tests',
      'MCP-UI-Tests',
      'MCP-OpenTelemetry-Tests'
    ],
    #coverage : {
      #packages : [
        'MCP',
        'MCP-UI',
        'MCP-OpenTelemetry'
      ],
      #format : #lcov
    }
  }
}
